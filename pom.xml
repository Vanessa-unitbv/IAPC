<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.example.rag</groupId>
    <artifactId>rag-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>rag-platform</name>
    <description>RAG microservices: Spring Boot, Spring AI, Eureka, Gateway, pgvector</description>

    <!-- Build everything from here: ./mvnw verify (one module: ./mvnw -pl ingest-static -am verify) -->
    <modules>
        <module>rag-common</module>
        <module>eureka-server</module>
        <module>api-gateway</module>
        <module>ingest-static</module>
        <module>ingest-dynamic</module>
        <module>retrieval-pre</module>
        <module>retrieval-post</module>
    </modules>

    <!-- The only place where versions are set. Modules declare dependencies without versions. -->
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <rag-common.version>0.0.1-SNAPSHOT</rag-common.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.edupulse</groupId>
                <artifactId>rag-common</artifactId>
                <version>${rag-common.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
