# Copy to .env and fill in the values. Never commit .env (it is in .gitignore).
# The same file is used by docker compose AND by the services when you run them from the IDE
# (each service imports .env or ../.env), so every name below has exactly one meaning.

# ---------- PostgreSQL + pgvector ----------
# Host and port as seen from your machine. Inside Docker, compose overrides them with pgvector:5432.
# If Docker reports that 5432 is not available (common on Windows), use 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# ---------- LLM and embeddings (any OpenAI-compatible API) ----------
LLM_API_KEY=sk-replace-me
# Must include /v1 (Spring AI 2 uses the official OpenAI SDK); without it every call returns 404.
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
# Changing the embedding model (or its dimensions) requires a full re-index.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------- Ingestion (Stories 1 and 2) ----------
# Folder with the static PDFs, relative to the working directory when run from the IDE.
INGEST_RESOURCES_DIR=./resources
# Chunk size and overlap in tokens (cl100k_base).
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# HMAC secret for vendor webhooks (Story 2, Task 3).
VENDOR_WEBHOOK_SECRET=change-me
# Comma-separated domains that may be fetched by ingest-dynamic (subdomains included). Empty means nothing is allowed.
# The default list covers the Story 2 demo sources configured in ingest-dynamic/application.yaml.
INGEST_ALLOWED_DOMAINS=en.wikipedia.org,brd.ro,raw.githubusercontent.com
INGEST_MAX_SIZE_MB=20
INGEST_TIMEOUT_SECONDS=20

# ---------- Retrieval (Stories 3 and 4) ----------
RETRIEVAL_TOP_K=20
SIMILARITY_THRESHOLD=0.70
QUERY_EXPANSION_VARIANTS=3
RERANK_TOP_K=5
STITCH_TOKEN_BUDGET=2000

# ---------- Ports published on localhost ----------
GATEWAY_PORT=8080
